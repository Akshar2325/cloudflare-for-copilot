{
	"name": "cloudflare-for-copilot",
	"publisher": "akshar-bhesaniya",
	"author": "akshar-bhesaniya",
	"displayName": "Cloudflare AI for GitHub Copilot Chat",
	"description": "Use Cloudflare Workers AI models directly in GitHub Copilot Chat with multi-account routing and configurable reasoning.",
	"icon": "assets/logo.png",
	"version": "1.0.0",
	"engines": {
		"vscode": "^1.104.0"
	},
	"categories": [
		"AI",
		"Chat",
		"Machine Learning",
		"Programming Languages"
	],
	"galleryBanner": {
		"color": "#100f11",
		"theme": "dark"
	},
	"keywords": [
		"language-models",
		"cloudflare",
		"workers-ai",
		"copilot",
		"ai",
		"chat"
	],
	"homepage": "https://developers.cloudflare.com/workers-ai/",
	"license": "MIT",
	"contributes": {
		"commands": [
			{
				"command": "cloudflareAI.manage",
				"title": "Cloudflare AI: Manage Provider"
			},
			{
				"command": "cloudflareAI.status",
				"title": "Cloudflare AI: Show Status"
			}
		],
		"configuration": {
			"title": "Cloudflare AI for Copilot",
			"properties": {
				"cloudflareAI.accounts": {
					"type": "array",
					"default": [],
					"markdownDescription": "Cloudflare accounts for multi-account routing. Stored in plain text and can sync via VS Code Settings Sync.",
					"items": {
						"type": "object",
						"required": [
							"accountId",
							"apiToken"
						],
						"properties": {
							"accountId": {
								"type": "string",
								"description": "Cloudflare account ID"
							},
							"apiToken": {
								"type": "string",
								"description": "API token (stored in settings as plain text)"
							},
							"label": {
								"type": "string",
								"description": "Friendly display name"
							}
						}
					}
				},
				"cloudflareAI.temperature": {
					"type": "number",
					"default": 0.2,
					"minimum": 0,
					"maximum": 2,
					"description": "Sampling temperature."
				},
				"cloudflareAI.requestTimeoutSeconds": {
					"type": "number",
					"default": 600,
					"minimum": 1,
					"description": "Total request timeout in seconds."
				},
				"cloudflareAI.streamIdleTimeoutSeconds": {
					"type": "number",
					"default": 120,
					"minimum": 1,
					"description": "Abort stream after this many idle seconds."
				},
				"cloudflareAI.debugLogging": {
					"type": "boolean",
					"default": false,
					"description": "Log raw SSE lines and request payloads in the Cloudflare AI output channel."
				},
				"cloudflareAI.proxyHost": {
					"type": "string",
					"default": "127.0.0.1",
					"description": "Host address for the local proxy server."
				},
				"cloudflareAI.proxyPort": {
					"type": "number",
					"default": 9300,
					"minimum": 1024,
					"maximum": 65535,
					"description": "Starting port for the local proxy server (will try next if in use)."
				}
			}
		}
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"scripts": {
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"lint": "eslint .",
		"format": "prettier --write .",
		"prepackage": "npm run lint && npm run compile",
		"package": "vsce package --allow-missing-repository",
		"vscode:prepublish": "npm run compile"
	},
	"dependencies": {},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/node": "^22",
		"@types/vscode": "^1.103.0",
		"@vscode/vsce": "^3.6.0",
		"eslint": "^9.13.0",
		"prettier": "^3.1.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0"
	}
}
